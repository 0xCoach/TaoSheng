  {
    "type": "function",
    "function": {
      "name": "semantic_search",
      "description": "按意思找事件和条目，适合措辞不同或关键词没命中；模型未就绪时返回空结果",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "完整检索意图"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "propose_change",
      "description": "仅准备一个待确认改动，不会修改数据；已有记录必须先查到，id 用结果的 id，不用 ref。每条回答最多一次。",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "item_status",
              "create_item",
              "item_due",
              "event_star"
            ]
          },
          "id": {
            "type": "integer",
            "description": "已有条目或事件的 id；新建不传"
          },
          "status": {
            "type": "string",
            "enum": [
              "Done",
              "Accepted",
              "Ignored"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "待办",
              "备忘"
            ]
          },
          "content": {
            "type": "string"
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD 或 YYYY-MM-DD HH:mm；null 清除截止时间"
          },
          "starred": {
            "type": "boolean"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
    }
  }
]
