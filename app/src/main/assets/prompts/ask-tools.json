[
  {
    "type": "function",
    "function": {
      "name": "search_lines",
      "description": "查原话，最多40句",
      "parameters": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "description": "中文短关键词，多个词 OR；空数组表示不限关键词"
          },
          "from": {
            "type": "string",
            "description": "YYYY-MM-DD 或 YYYY-MM-DD HH:mm"
          },
          "to": {
            "type": "string",
            "description": "YYYY-MM-DD 或 YYYY-MM-DD HH:mm"
          },
          "speaker": {
            "type": "string",
            "description": "说话人名称或原始标签"
          }
        },
        "required": [
          "keywords"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_events",
      "description": "查事件标题、摘要、要点；有关键词时合并本地语义结果，最多10条",
      "parameters": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "description": "中文短关键词，多个词 OR；空数组表示不限关键词"
          },
          "from": {
            "type": "string",
            "description": "YYYY-MM-DD 或 YYYY-MM-DD HH:mm"
          },
          "to": {
            "type": "string",
            "description": "YYYY-MM-DD 或 YYYY-MM-DD HH:mm"
          },
          "starred_only": {
            "type": "boolean",
            "description": "只查用户标的重点；没有关键词时按标重点时间倒序"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
