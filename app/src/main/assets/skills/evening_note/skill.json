{
  "formatVersion": 1,
  "id": "evening_note",
  "name": "收工打卡",
  "summary": "用自己的记录回看今天做了什么",
  "icon": "sunset",
  "version": 1,
  "trigger": {
    "type": "Daily",
    "minutes": 1080,
    "weekdays": []
  },
  "scope": {
    "range": "Day",
    "speakers": "MeOnly",
    "includeLines": true
  },
  "fields": [
    {
      "key": "done",
      "label": "今天做了什么",
      "type": "Bullets",
      "hint": "只写我做的事情，相似内容合并",
      "required": true
    },
    {
      "key": "progress",
      "label": "推进到哪",
      "type": "Paragraph",
      "hint": "明确进度和仍未解决的部分",
      "required": false
    },
    {
      "key": "tomorrow",
      "label": "明天计划",
      "type": "Checklist",
      "hint": "只写本人明确说过的计划，不替本人安排",
      "required": false
    },
    {
      "key": "line",
      "label": "一句收工话",
      "type": "Text",
      "hint": "克制、具体，不鸡汤",
      "required": false
    }
  ],
  "maxCardsPerDay": 1,
  "push": true,
  "order": 1
}
